{
  "manifest_version": 3,
  "name": "Onextap",
  "version": "1.0.1",
  "description": "Autofill job applications.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "identity"
  ],
  "host_permissions": [
    "https://*.supabase.co/*",
    "https://www.onextap.com/*",
    "https://onextap.com/*",
    "http://localhost:5173/*",
    "http://localhost:3001/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://www.onextap.com/*",
      "https://onextap.com/*",
      "http://localhost:5173/*"
    ]
  },
  "background": {
    "service_worker": "extension/background.js"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": "icon.png"
  }
}