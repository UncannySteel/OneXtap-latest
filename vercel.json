{
  "version": 2,
  "buildCommand": "vite build --config vite.dashboard.config.js",
  "outputDirectory": "dist-dashboard",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/privacy-policy",
      "destination": "/privacy/",
      "permanent": true
    },
    {
      "source": "/privacy-policy.html",
      "destination": "/privacy/",
      "permanent": true
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/jobs/ingest",
      "schedule": "0 6 * * *"
    }
  ]
}
