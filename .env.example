# Supabase (get from https://supabase.com → Project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key...

# Backend API URL
#   Local dev:  http://localhost:3001
#   Extension production build: https://www.onextap.com
#   Vercel dashboard: leave empty (uses same-origin relative URLs)
VITE_API_URL=http://localhost:3001

# Dashboard URL (used for extension → dashboard links and payment redirects)
#   Local dev:  http://localhost:5173
#   Production: https://www.onextap.com
VITE_DASHBOARD_URL=http://localhost:5173

# Answer Studio model id (sent to backend Groq endpoint)
VITE_ANSWER_STUDIO_MODEL=llama-3.3-70b-versatile
