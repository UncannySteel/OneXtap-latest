# Supabase (get from https://supabase.com → Project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key...

# Backend server URL (change for production)
VITE_API_URL=http://localhost:3001

# Dashboard URL (used for payment redirects)
VITE_DASHBOARD_URL=http://localhost:5173

# Answer Studio model (sent to backend Anthropic endpoint)
VITE_ANSWER_STUDIO_MODEL=claude-3-5-sonnet-latest
