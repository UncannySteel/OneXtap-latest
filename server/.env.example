# Supabase (get from https://supabase.com → Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# Dodo Payments API Key (get from https://app.dodopayments.com → Developer → API Keys)
DODO_PAYMENTS_API_KEY=YOUR_API_KEY_HERE

# Dodo Payments Webhook Secret (get from https://app.dodopayments.com → Settings → Webhooks)
DODO_PAYMENTS_WEBHOOK_KEY=YOUR_WEBHOOK_SECRET_HERE

# Dodo Payments Product ID for Premium subscription
# Create a subscription product in Dodo Payments Dashboard → Products
DODO_PRODUCT_ID=prod_XXXXXXXXXXXXXXXXXXXXXXXX

# Dodo Payments Environment: test_mode or live_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Google Gemini API (Resume parsing, and the PRIMARY model for job ranking)
# Get key from: https://aistudio.google.com/apikey (free tier available)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Optional primary model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
# Optional fallback model if primary is unavailable (default: gemini-2.5-pro)
# Used by resume parsing only. Ranking pins itself to GEMINI_MODEL and falls
# back to Groq instead — 2.5-pro is slower per call and more tightly rationed
# on the free tier, which is the wrong trade inside a bounded rank.
GEMINI_FALLBACK_MODEL=gemini-2.5-pro

# Groq API (Answer Studio / Answer Vault, and the FALLBACK for job ranking)
# Get key from: https://console.groq.com/
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
#
# ⚠ SET THESE EXPLICITLY. The defaults below are Llama ids that are NOT
# available on every Groq account — an account without them 404s on every
# single call, and because each route degrades politely the symptom is not an
# error but everything quietly getting worse. Check what your key can actually
# reach before trusting the defaults:
#   curl -s https://api.groq.com/openai/v1/models \
#     -H "Authorization: Bearer $GROQ_API_KEY" | grep -o '"id":"[^"]*"'
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
# Optional max output tokens per generation (default 4096; values below 256 are
# ignored, and the effective value is capped at 8192).
# GROQ_MAX_TOKENS=4096
# Per-request ceiling and SDK retry count for Groq (defaults: 20000, 0).
# maxRetries is 0 on purpose: Groq's free-tier 429s carry retry-after: 18, so a
# retry costs more than the whole rank budget and the keyword fallback is both
# faster and honest about itself. Raise it on a paid tier, where the limiter
# clears in a fraction of a second.
# GROQ_TIMEOUT_MS=20000
# GROQ_MAX_RETRIES=0

# ------------------------------------------------------------------
# Job ranking
# ------------------------------------------------------------------
# Which provider scores jobs first. 'gemini' (default) or 'groq'.
# Gemini leads because the two free tiers are rationed along different axes:
# Groq caps TOKENS per minute (8k — a 30-job pass does not fit), Gemini caps
# REQUESTS per minute (a 30-job pass is two). Groq is still reached for as a
# second, separately-metered budget when Gemini is unavailable.
# RANK_PROVIDER=gemini
#
# Wall-clock budget for one rank, in ms (default 40000). The graph stops
# starting new loops once spending it would overrun, and returns what it has.
# Sized under the Vercel Hobby function ceiling of 60s — raise BOTH together or
# neither, or the platform kills the request the budget was protecting.
# RANK_BUDGET_MS=40000

# ------------------------------------------------------------------
# Job ingest (server-only — NEVER prefix any of these with VITE_, which would
# inline them into the shipped browser bundle)
# ------------------------------------------------------------------

# Adzuna job search API (free tier). Register at https://developer.adzuna.com/
# Both must be set or the adzuna adapter reports itself disabled.
ADZUNA_APP_ID=YOUR_ADZUNA_APP_ID
ADZUNA_APP_KEY=YOUR_ADZUNA_APP_KEY
# Comma-separated ISO country codes; only the first is used today. Default: us
ADZUNA_COUNTRIES=us

# ATS job boards — comma-separated provider:board pairs. Keyless; the only
# source whose descriptions are the COMPLETE posting rather than a ~200-char
# snippet. Providers: greenhouse, lever, ashby. UNSET = the adapter is disabled.
# Needs migration 003_ats_source.sql applied, or every row is rejected.
# ATS_BOARDS=greenhouse:figma,lever:spotify,ashby:ramp

# Shared secret for /api/jobs/ingest. Vercel injects it as an Authorization
# Bearer header on cron runs when it is set as a project env var; curl can send
# it as X-Cron-Secret instead. UNSET = the route answers 503 (fail closed).
CRON_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# Set to 'true' to allow the synthetic cached_jobs.json fixtures as a live
# source in production. Off by default: those listings are invented and point
# at example.com. Only for a keyless staging deploy.
ALLOW_CACHE_SOURCE=false

# ------------------------------------------------------------------
# Opik observability (server-only — NEVER prefix any of these with VITE_,
# which would inline them into the shipped browser bundle)
# ------------------------------------------------------------------

# Opik API key. UNSET = tracing is off entirely, the SDK is never loaded, and
# the server behaves exactly as it did before the observability layer existed.
#
# Deliberately left commented out: a copied-but-unedited placeholder would be a
# non-empty string, which switches tracing ON with a key that cannot
# authenticate. Uncomment it only when you actually want traces.
# OPIK_API_KEY=your-opik-api-key

# Opik workspace name (default: default)
OPIK_WORKSPACE=default
# Opik project traces are filed under (default: onextap)
OPIK_PROJECT_NAME=onextap
# Base URL of a self-hosted Opik install; leave blank for Opik Cloud
OPIK_URL_OVERRIDE=

# Your dashboard URL (where users return after checkout)
#   Local dev:  http://localhost:5173
#   Production: https://www.onextap.com
CLIENT_URL=http://localhost:5173

# Server port
PORT=3001
