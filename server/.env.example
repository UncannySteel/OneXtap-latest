# Supabase (get from https://supabase.com → Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# Dodo Payments API Key (get from https://app.dodopayments.com → Developer → API Keys)
DODO_PAYMENTS_API_KEY=YOUR_API_KEY_HERE

# Dodo Payments Webhook Secret (get from https://app.dodopayments.com → Settings → Webhooks)
DODO_PAYMENTS_WEBHOOK_KEY=YOUR_WEBHOOK_SECRET_HERE

# Dodo Payments Product ID for Premium subscription
# Create a subscription product in Dodo Payments Dashboard → Products
DODO_PRODUCT_ID=prod_XXXXXXXXXXXXXXXXXXXXXXXX

# Dodo Payments Environment: test_mode or live_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Google Gemini API (Answer Studio + Resume Parsing)
# Get key from: https://aistudio.google.com/apikey (free tier available)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Optional primary model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
# Optional fallback model if primary is unavailable (default: gemini-2.5-pro)
GEMINI_FALLBACK_MODEL=gemini-2.5-pro
# Optional Answer Studio quality model (default: gemini-2.5-pro)
ANSWER_STUDIO_MODEL=gemini-2.5-pro
# Optional Answer Studio fallback model (default: gemini-2.5-flash)
ANSWER_STUDIO_FALLBACK_MODEL=gemini-2.5-flash

# Your dashboard URL (where users return after checkout)
#   Local dev:  http://localhost:5173
#   Production: https://www.onextap.com
CLIENT_URL=http://localhost:5173

# Server port
PORT=3001
